{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "GET3W_DEV_MODE"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:local": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ]
    }
  }
}
